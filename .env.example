# Copy this file to .env (in the same folder as muni_board.py) and fill it in.
# .env is private: it is listed in .gitignore and must never be committed.

# Your 511.org API key. Request one (free) at https://511.org/open-data/token
API_511_KEY=paste-your-key-here

# The 5-digit Muni stop number, printed on the stop's sign or shelter.
# Each direction has its own number. Example: 13008
STOP_CODE=
